---
/**
 * Cursor fish — a chubby pixel fish that dangles on a string below the mouse
 * pointer and swings with a bit of pendulum physics (like the pet in the
 * reference video).
 *
 * The component is intentionally dependency free: one canvas, one inline
 * script. It disables itself on touch devices and when the visitor asks for
 * reduced motion, and it survives Astro view transitions thanks to
 * `transition:persist`.
 */
import fishSprite from '~/assets/cursor-pet/fish.png';

export interface Props {
  /** Disable without removing the component. */
  enabled?: boolean;
  /** Rendered fish height in CSS pixels. */
  size?: number;
  /** Rope length in CSS pixels. */
  ropeLength?: number;
  /** Optional replacement sprite sheet (5 frames in one row). */
  sprite?: string;
}

const { enabled = true, size = 40, ropeLength = 68, sprite = fishSprite.src } = Astro.props;
---

{
  enabled && (
    <canvas
      class="cursor-fish"
      aria-hidden="true"
      data-sprite={sprite}
      data-size={size}
      data-rope={ropeLength}
      transition:persist="cursor-fish"
    />
  )
}

<style>
  .cursor-fish {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .cursor-fish[data-visible='true'] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-fish {
      display: none;
    }
  }
</style>

<script>
  type Bubble = { x: number; y: number; vx: number; vy: number; r: number; life: number };

  const FRAME_W = 38;
  const FRAME_H = 26;
  const ATTACH_X = 15;
  const ATTACH_Y = 2;

  // pendulum tuning
  const GRAVITY = 2600; // px/s², acts as the restoring force of the string
  const SWING_DAMPING = 1.9; // 1/s, how quickly the swinging dies down
  const DRAG = 70; // rad/s², how much a fast cursor drags the fish behind it
  const DRAG_REF = 1800; // px/s of cursor speed that means "full drag"
  const SMOOTHING = 14; // how fast the rope anchor chases the pointer
  const MAX_ANGLE = 1.45; // radians, keeps the fish from flying above the cursor
  const FIXED_STEP = 1 / 120;

  const boot = (canvas: HTMLCanvasElement) => {
    if (canvas.dataset.booted === 'true') return;
    canvas.dataset.booted = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (reduceMotion || !canHover) {
      canvas.remove();
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const urlParams = new URLSearchParams(window.location.search);
    const demoMode = urlParams.has('fishdemo');
    const debugMode = demoMode && urlParams.has('debug');
    // `?fishdemo&size=44&rope=62` lets us tune the proportions against the
    // reference effect without a rebuild.
    const override = (key: string) => (demoMode ? Number(urlParams.get(key)) || 0 : 0);

    const fishHeight = override('size') || Number(canvas.dataset.size) || 40;
    const ropeLength = override('rope') || Number(canvas.dataset.rope) || 68;
    const scale = fishHeight / FRAME_H;

    const sprite = new Image();
    sprite.decoding = 'async';
    sprite.src = canvas.dataset.sprite as string;

    let dpr = 1;
    let width = 0;
    let height = 0;
    let visible = false;
    let running = false;
    let lastFrame = 0;
    let accumulator = 0;
    let elapsed = 0;

    const anchor = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };
    const fishPos = { x: 0, y: 0 };

    // pendulum state: angle from straight down, angular velocity
    let theta = 0;
    let omega = 0;
    let pivotVX = 0;

    const bubbles: Bubble[] = [];

    let nextBlinkAt = 2500;
    let blinkUntil = 0;
    let happyUntil = 0;
    let lastPointer = { x: 0, y: 0, t: 0 };
    let pointerSpeed = 0;

    // handy for automated visual checks: window.__cursorFishDebug()
    (window as unknown as Record<string, unknown>).__cursorFishDebug = () => ({
      anchor: { ...anchor },
      tail: { ...fishPos },
      angle: theta,
      visible,
      elapsed,
    });

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = false;
    };

    const layout = (x: number, y: number) => {
      anchor.x = x;
      anchor.y = y;
      target.x = x;
      target.y = y;
      theta = 0;
      omega = 0;
      pivotVX = 0;
      fishPos.x = x;
      fishPos.y = y + ropeLength;
    };

    const show = () => {
      if (visible) return;
      visible = true;
      canvas.dataset.visible = 'true';
      if (!running) {
        running = true;
        lastFrame = performance.now();
        requestAnimationFrame(tick);
      }
    };

    const hide = () => {
      visible = false;
      canvas.dataset.visible = 'false';
    };

    const simulate = (dt: number) => {
      elapsed += dt;

      // the anchor (where the string is tied to the cursor) lags a touch so
      // quick flicks drag the whole thing behind the pointer
      const ease = 1 - Math.exp(-SMOOTHING * dt);
      const previousX = anchor.x;
      anchor.x += (target.x - anchor.x) * ease;
      anchor.y += (target.y - anchor.y) * ease;

      // horizontal speed of the pivot, smoothed, in px/s
      const instantVX = dt > 0 ? (anchor.x - previousX) / dt : 0;
      pivotVX += (instantVX - pivotVX) * Math.min(1, dt * 24);

      let steps = Math.ceil(dt / FIXED_STEP);
      steps = Math.max(1, Math.min(steps, 6));
      const step = dt / steps;

      // gentle idle wind so the fish is never completely dead
      const wind = Math.sin(elapsed * 1.7) * 0.35 + Math.sin(elapsed * 0.61) * 0.22;

      for (let s = 0; s < steps; s++) {
        // the cursor pulls the bob sideways by at most DRAG, so a flick swings
        // the fish instead of whipping it over the pointer
        const drag = Math.max(-1.6, Math.min(1.6, pivotVX / DRAG_REF));
        const accel =
          -(GRAVITY / ropeLength) * Math.sin(theta) -
          SWING_DAMPING * omega -
          DRAG * drag * Math.cos(theta) +
          wind;

        omega += accel * step;
        theta += omega * step;

        if (theta > MAX_ANGLE) {
          theta = MAX_ANGLE;
          omega *= -0.2;
        } else if (theta < -MAX_ANGLE) {
          theta = -MAX_ANGLE;
          omega *= -0.2;
        }
      }

      fishPos.x = anchor.x + Math.sin(theta) * ropeLength;
      fishPos.y = anchor.y + Math.cos(theta) * ropeLength;

      // bubbles drift upwards and fade
      for (let i = bubbles.length - 1; i >= 0; i--) {
        const b = bubbles[i];
        b.life -= dt;
        if (b.life <= 0) {
          bubbles.splice(i, 1);
          continue;
        }
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.vy += 12 * dt;
        b.vx *= 0.99;
      }
    };

    const currentFrame = (now: number) => {
      if (now < happyUntil) return 4;
      if (now < blinkUntil) return 3;
      const phase = elapsed % 2.4;
      if (phase < 0.52) {
        const step = Math.floor((phase / 0.52) * 4) % 4;
        return [0, 1, 0, 2][step];
      }
      return 0;
    };

    const traceRope = (dark: boolean) => {
      // the string bows a little against the swing, like a real rope
      const bend = Math.max(-14, Math.min(14, -omega * 4.5));
      const dirX = Math.sin(theta);
      const dirY = Math.cos(theta);
      const midX = (anchor.x + fishPos.x) / 2 - dirY * bend;
      const midY = (anchor.y + fishPos.y) / 2 + dirX * bend;

      ctx.beginPath();
      ctx.moveTo(anchor.x, anchor.y);
      ctx.quadraticCurveTo(midX, midY, fishPos.x, fishPos.y);
      // the string has to stay readable on both the light and the dark theme
      ctx.strokeStyle = dark ? 'rgba(206, 224, 244, 0.5)' : 'rgba(20, 38, 62, 0.7)';
      ctx.lineWidth = Math.max(1.3, scale * 0.5);
      ctx.lineCap = 'round';
      ctx.stroke();
    };

    const drawFish = () => {
      // a tiny amount of breathing keeps it lively
      const bob = Math.sin(elapsed * 2.1) * 0.045;
      const angle = theta + bob;

      const frame = currentFrame(performance.now());

      ctx.save();
      ctx.translate(fishPos.x, fishPos.y);
      ctx.rotate(angle);
      ctx.scale(scale, scale);
      ctx.drawImage(sprite, frame * FRAME_W, 0, FRAME_W, FRAME_H, -ATTACH_X, -ATTACH_Y, FRAME_W, FRAME_H);
      ctx.restore();
    };

    const drawBubbles = () => {
      for (const b of bubbles) {
        const alpha = Math.min(1, b.life * 1.6);
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${alpha * 0.55})`;
        ctx.fill();
        ctx.lineWidth = 1;
        ctx.strokeStyle = `rgba(90, 160, 215, ${alpha * 0.8})`;
        ctx.stroke();
      }
    };

    const drawDebug = () => {
      ctx.save();
      ctx.fillStyle = 'rgba(255,60,60,0.95)';
      ctx.beginPath();
      ctx.arc(anchor.x, anchor.y, 3.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'rgba(0,255,180,0.95)';
      ctx.beginPath();
      ctx.arc(fishPos.x, fishPos.y, 2.2, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const tick = (now: number) => {
      if (!running) return;
      const raw = (now - lastFrame) / 1000;
      lastFrame = now;

      if (!visible || document.hidden) {
        requestAnimationFrame(tick);
        return;
      }

      const dt = Math.min(Math.max(raw, 0.0001), 0.05);
      accumulator += dt;
      // keep the pendulum stable: consume time in fixed chunks
      while (accumulator >= FIXED_STEP) {
        simulate(FIXED_STEP);
        accumulator -= FIXED_STEP;
      }

      if (now > nextBlinkAt) {
        blinkUntil = now + 130;
        nextBlinkAt = now + 2400 + Math.random() * 3600;
      }

      ctx.clearRect(0, 0, width, height);
      ctx.lineJoin = 'round';
      traceRope(document.documentElement.classList.contains('dark'));
      drawBubbles();
      drawFish();
      if (debugMode) drawDebug();

      requestAnimationFrame(tick);
    };

    resize();
    window.addEventListener('resize', resize);

    window.addEventListener(
      'pointermove',
      (event) => {
        const now = event.timeStamp || performance.now();
        if (!visible) {
          layout(event.clientX, event.clientY);
          lastPointer = { x: event.clientX, y: event.clientY, t: now };
          show();
          return;
        }
        target.x = event.clientX;
        target.y = event.clientY;

        const dt = Math.max(1, now - lastPointer.t);
        const dx = event.clientX - lastPointer.x;
        const dy = event.clientY - lastPointer.y;
        pointerSpeed = (Math.hypot(dx, dy) / dt) * 1000;
        lastPointer = { x: event.clientX, y: event.clientY, t: now };
      },
      { passive: true }
    );

    window.addEventListener(
      'pointerdown',
      () => {
        if (!visible) return;
        happyUntil = performance.now() + 520;

        // little jolt: kick the pendulum and let it swing back
        omega += 1.4 + Math.min(2.2, pointerSpeed * 0.0012);

        for (let i = 0; i < 5; i++) {
          bubbles.push({
            x: fishPos.x + (Math.random() - 0.5) * 26,
            y: fishPos.y + (Math.random() - 0.3) * 18,
            vx: (Math.random() - 0.5) * 24,
            vy: -16 - Math.random() * 26,
            r: 1.6 + Math.random() * 2.2,
            life: 0.6 + Math.random() * 0.4,
          });
        }
      },
      { passive: true }
    );

    document.addEventListener('mouseleave', hide);
    document.addEventListener('mouseenter', () => {
      if (visible) return;
      if (fishPos.x || fishPos.y) show();
    });
  };

  // Development-only harness: open any page with `?fishdemo` to drive the
  // pointer around in a loop (handy for screenshots and for tuning physics).
  // `&drift` makes it dash around so the fish swings, `&hold` keeps the harness
  // out of the way so a real pointer can be used instead.
  const demo = () => {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('fishdemo')) return;
    if (params.has('hold')) return;
    const drift = params.has('drift');
    const started = performance.now();
    const drive = () => {
      const t = (performance.now() - started) / 1000;
      const ampX = drift ? Math.min(window.innerWidth * 0.32, 420) : 90;
      const ampY = drift ? Math.min(window.innerHeight * 0.28, 220) : 55;
      const speedX = drift ? 1.1 : 0.32;
      const speedY = drift ? 1.7 : 0.47;
      const x = window.innerWidth / 2 + Math.cos(t * speedX) * ampX;
      const y = window.innerHeight / 2 + Math.sin(t * speedY) * ampY;
      window.dispatchEvent(new PointerEvent('pointermove', { clientX: x, clientY: y }));
      requestAnimationFrame(drive);
    };
    requestAnimationFrame(drive);
  };

  const init = () => {
    for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.cursor-fish')) {
      boot(canvas);
    }
  };

  init();
  demo();
  document.addEventListener('astro:page-load', init);
</script>
