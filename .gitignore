# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# pnpm 是 GitHub Actions 云端编译使用的包管理器（见 .github/workflows/），
# pnpm-lock.yaml / pnpm-workspace.yaml 必须入库，否则 CI 的 --frozen-lockfile
# 无法工作。Dockerfile 仍用 npm + package-lock.json：改依赖时请两个 lockfile
# 一起更新（pnpm install / npm install --package-lock-only）。

.astro

# desktop / mobile app build artifacts (see docs/apps/APP-SPEC.md)
# Installers are delivered through releases/ on disk and GitHub Releases, not git.
apps/windows/node_modules/
apps/windows/dist-package/
apps/windows/out/
apps/windows/.electron-cache/
# 内置站点快照由 build.ps1 从 dist/ 重新生成，不入库（避免仓库里存两份 19MB 站点）
apps/windows/site/
apps/android/app/src/main/assets/www/
apps/android/.toolchain/
apps/android/.build/
apps/android/build/
releases/

# keep the Android signing key: it is required for future APK updates
!apps/android/keystore/mobellsite.keystore

# tmp
.tmp