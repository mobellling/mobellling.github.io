---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Headline from '~/components/blog/Headline.astro';
import { getPermalink } from '~/utils/permalinks';
import { changelog } from '~/data/changelog';

const metadata = {
  title: '更新日志',
  description: 'MobellSite 更新日志，按时间记录网站功能、页面设计、内容结构和部署配置的变化，帮助你了解这个个人网站从搭建到持续改进的过程。',
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={[{ text: '主页', href: getPermalink('/') }, { text: '其他' }, { text: '更新日志' }]} />
  <section class="mx-auto max-w-3xl px-6 py-12 sm:py-16 lg:py-20">
    <Headline subtitle="记录每一次改变，也保留一路走来的痕迹">更新日志</Headline>

    <div
      class="relative mt-10 space-y-8 before:absolute before:bottom-2 before:left-[0.4375rem] before:top-2 before:w-px before:bg-primary/20"
    >
      {
        changelog.map((entry) => (
          <article class="relative pl-8">
            <span class="absolute left-0 top-2 h-3.5 w-3.5 rounded-full border-4 border-page bg-primary shadow-[0_0_0_4px_color-mix(in_srgb,var(--aw-color-primary)_12%,transparent)]" />
            <div class="site-surface rounded-[var(--aw-radius-card)] border p-5 sm:p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
                <time datetime={entry.date} class="font-medium text-primary">
                  {entry.date}
                </time>
                <span aria-hidden="true">·</span>
                <span>{entry.version}</span>
              </div>
              <h2 class="mt-2 font-heading text-xl font-bold text-heading sm:text-2xl">{entry.title}</h2>
              <ul class="mt-4 space-y-2 text-muted">
                {entry.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-primary">✦</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
