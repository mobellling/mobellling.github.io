---
/**
 * Giscus comments for a single moment.
 *
 * Mapping is `pathname`, so every moment permalink gets its own GitHub
 * Discussion. Reactions are enabled, which gives each moment a lightweight
 * “点赞” control without any backend.
 */
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class={`mt-12 pt-8 border-t border-gray-200 dark:border-slate-700 ${className}`} aria-label="点赞与留言">
  <p class="text-sm text-muted dark:text-slate-400 mb-4">
    点赞、留言由 GitHub Discussions 提供，需要登录 GitHub 账号。首次互动时会在仓库中创建对应讨论。
  </p>
  <div class="giscus" style="min-height: 320px"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="mobellling/mobellling.github.io"
    data-repo-id="R_kgDOVU1Z4g"
    data-category="Announcements"
    data-category-id="DIC_kwDOVU1Z4s4DJfbN"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>
